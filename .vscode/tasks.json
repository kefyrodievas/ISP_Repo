{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run PCBuilder",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Developer/run.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run React",
      "type": "shell",
      "command": "npm.cmd run dev -- --host 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}/PCBuilder/Frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "react",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": ".*Local:\\s+http://127\\.0\\.0\\.1:5173/.*"
        }
      }
    }
  ]
}