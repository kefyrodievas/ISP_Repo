
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run PCBuilder",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Developer/run.ps1"
      ],
      "windows": {
        "command": "powershell.exe"
      },
      "linux": {
        "command": "dotnet",
        "args": [
          "run",
          "--project",
          "${workspaceFolder}/PCBuilder/PCBuilder.csproj",
          "--",
          "--urls",
          "http://localhost:5197"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "Run React",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/PCBuilder/Frontend"
      },
      "windows": {
        "command": "npm.cmd"
      },
      "linux": {
        "command": "npm"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "react",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": ".*Local:\\s+http://127\\.0\\.0\\.1:5173/.*"
        }
      }
    }
  ]
}
